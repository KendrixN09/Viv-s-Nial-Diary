# Supabase (Settings -> API in your Supabase project)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard
ADMIN_PASSWORD=
# Any long random string - used to sign the admin login session, not shown anywhere.
# IMPORTANT: on Vercel, this one must be added with "Sensitive" turned OFF -
# it's read inside middleware.ts, which always runs on the Edge runtime, and
# Vercel's Sensitive env vars are not readable from Edge Middleware.
ADMIN_SESSION_SECRET=

# --- Everything below is OPTIONAL and NOT part of the current flow ---
# Viv contacts clients herself (call/text/DM buttons in the admin dashboard)
# instead of automatic SMS, so Twilio isn't needed at all right now. The
# integration code is still here in case that ever changes later - leaving
# these blank runs it in a harmless mock mode that's never actually called
# by the app today.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google Calendar (service account, not personal OAuth - see README) - also
# not in use since the admin dashboard's own Calendar tab covers this.
# Leave blank to run in safe mock mode.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
